POSTGRES_USER=meetings
POSTGRES_PASSWORD=meetings
POSTGRES_DB=meetings
# Host port for Postgres (change if 5432 is already in use)
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://meetings:meetings@db:5432/meetings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AWS deployment (make deploy-backend) ---
# Credentials of an IAM user allowed to manage CloudFormation, Lambda, EC2/VPC, RDS, ECR,
# IAM roles, SSM Parameter Store, S3, CloudFront and CloudWatch Logs. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary (STS) credentials
AWS_SESSION_TOKEN=
AWS_REGION=eu-central-1
# Prefix for all AWS resource and stack names
APP_NAME=new-project
# Extra origins allowed to call the deployed API, comma-separated. Not needed for the
# CloudFront frontend, which serves the app and /api from the same origin.
CORS_ORIGINS_AWS=
# Backend Lambda memory in MB (CPU scales with it; 400,000 GB-seconds/month are free)
LAMBDA_MEMORY=512
