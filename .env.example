POSTGRES_USER=meetings
POSTGRES_PASSWORD=meetings
POSTGRES_DB=meetings
# Host port for Postgres (change if 5432 is already in use)
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://meetings:meetings@db:5432/meetings
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AWS deployment (make deploy-backend) ---
# Credentials of an IAM user allowed to manage CloudFormation, EC2/VPC, RDS, ECR, IAM roles,
# SSM (Parameter Store + Run Command) and CloudWatch Logs. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary (STS) credentials
AWS_SESSION_TOKEN=
AWS_REGION=eu-central-1
# Prefix for all AWS resource and stack names
APP_NAME=new-project
# Origins allowed to call the deployed API, comma-separated (e.g. the deployed frontend URL)
CORS_ORIGINS_AWS=
# Free-tier eligible EC2 type: t3.micro (current free plan) or t2.micro (legacy 12-month free tier)
EC2_INSTANCE_TYPE=t3.micro
